/* jshint node: true, browser: false */
/* eslint-env node */

module.exports = grunt => {
    const glob = require('glob');

    // Find SCSS files in the snippets folder
    const scssFiles = glob.sync('snippets/**/*.scss');

    // Configure stylelint for SCSS files
    grunt.config.merge({
        stylelint: {
            scss: {
                options: {
                    quietDeprecationWarnings: true,
                    customSyntax: 'postcss-scss',
                },
                src: scssFiles,
            }
        }
    });

    // Load the stylelint task
    grunt.loadNpmTasks('grunt-stylelint');

    // Register the SCSS linting task
    grunt.registerTask('lint-scss', ['stylelint:scss']);

    // Add the watch configuration for SCSS files
    grunt.config.merge({
        watch: {
            scss: {
                files: ['snippets/**/*.scss'], // Watch SCSS files in the snippets folder
                tasks: ['lint-scss']
            },
        },
    });
};
